{
	email {$ACME_EMAIL}
}

{$VLLM_DOMAIN} {
	# Auth gate on EVERY path.
	# vLLM's own --api-key only covers /v1, /v2 and /inference. It leaves
	# /invocations unauthenticated, and that endpoint exposes the same
	# inference capability. So the proxy, not vLLM, is the real gate.
	@unauthorized not header Authorization "Bearer {$VLLM_API_KEY}"
	handle @unauthorized {
		header Content-Type application/json
		respond `{"error":{"message":"Invalid API key.","type":"invalid_request_error","code":"invalid_api_key"}}` 401
	}

	# Named route for Muse-Glimmer. handle_path strips the prefix, so
	# /muse/v1/models reaches the backend as /v1/models.
	handle_path /muse/* {
		reverse_proxy 127.0.0.1:8000 {
			# Stream SSE tokens through with no buffering.
			flush_interval -1
			# Long generations must not be killed by proxy timeouts.
			transport http {
				read_timeout 3600s
				write_timeout 3600s
				compression off
			}
		}
	}

	# To serve a second model behind the same hostname and key, run it on
	# another port and uncomment a block like this. Then add a second provider
	# in the client's models.json pointing at https://HOST/<name>/v1
	#
	# handle_path /other/* {
	# 	reverse_proxy 127.0.0.1:8002 {
	# 		flush_interval -1
	# 		transport http {
	# 			read_timeout 3600s
	# 			write_timeout 3600s
	# 			compression off
	# 		}
	# 	}
	# }

	# Default route, so a bare /v1 base URL also works.
	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
				compression off
			}
		}
	}

	encode zstd gzip

	# Log to stderr, not a file. Caddy's systemd sandbox denies writes to
	# /var/log/caddy even when the directory is owned by the caddy user,
	# which makes the service fail to start with "permission denied".
	log {
		output stderr
		format json
	}
}
