# Tunables for the Muse-Glimmer-30B vLLM server.
# Edit, then: systemctl restart muse-glimmer

IMAGE=vllm-rocm:0.28.0-gfx942
MODEL_DIR=/models/Muse-Glimmer-30B
SERVED_NAME=muse-glimmer-30b
PORT=8000

# Publish on loopback only. Docker's iptables rules bypass ufw, so a firewall
# rule alone does NOT close a published container port. Remote access goes
# through the Caddy reverse proxy (see 05-endpoint-secure.sh).
BIND_ADDR=127.0.0.1

# Model's native context.
MAX_MODEL_LEN=131072

# One MI300X, so tensor parallel 1 avoids all collective overhead.
TP=1

# IMPORTANT: vLLM compares (GPU_MEM_UTIL x TOTAL VRAM) against FREE VRAM at
# startup. This box also runs a separate Mistral server holding ~84 GiB, so
# 0.50 (about 96 GiB) is chosen to fit in the ~106 GiB that remains.
# Weights are 55.5 GiB, leaving roughly 40 GiB of KV cache.
# If this GPU is ever dedicated to Muse-Glimmer alone, raise this to 0.90.
GPU_MEM_UTIL=0.50

MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=8192

# Cap multimodal input. The model accepts images; this bounds the encoder cache.
LIMIT_MM_IMAGE=4

# Optimisation toggles. Set any to 0 to bisect a failing startup.
USE_AITER=1          # AMD AITER fused kernels
USE_ASYNC_SCHED=1    # overlap scheduling with GPU execution
USE_PREFIX_CACHE=1   # reuses the system prompt across agent turns
